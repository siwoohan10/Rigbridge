{
  "manifest_version": 3,
  "name": "RigBridge 태블릿 연결",
  "version": "1.0.1",
  "description": "브라우저에서 보이는 YouTube·X·BOOTH 추천 카드를 이 PC의 RigBridge로 보내 VRChat 방 태블릿에 표시합니다.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "RigBridge 태블릿 연결", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["common.js", "youtube.js"], "run_at": "document_idle" },
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["common.js", "x.js"], "run_at": "document_idle" },
    { "matches": ["https://booth.pm/*", "https://*.booth.pm/*"], "js": ["common.js", "booth.js"], "run_at": "document_idle" }
  ]
}
